# Choose a local alphanumeric password; do not commit .env.
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+psycopg://flags:replace_me@localhost:5433/flags
CACHE_MAX_ENTRIES=1024
CACHE_TTL_SECONDS=5
# Local use may omit the key; cloud deployment must set both values.
REQUIRE_API_KEY=false
# API_KEY=generate_a_random_key_of_at_least_32_characters
